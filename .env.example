# ===== 高考满分作文智能应用 配置 =====
# 复制本文件为 .env 并填写实际值

# 必填：OpenAI API Key（或兼容端点的 Key）
OPENAI_API_KEY=sk-ws-H.YEXXHYH.TFRk.MEYCIQDWFs2sFi_ukNn8dPfEnYgnSo3N6Hnb5_be9Cz7w-5qiAIhALOen58XO3NOz3bwx38WMCRAFqQ5s0FiQ2o3Vss30mc3

# 可选：API 地址。默认 OpenAI 官方；也可指向任何 OpenAI 兼容端点，例如：
#   DeepSeek:  https://api.deepseek.com/v1
#   Moonshot:  https://api.moonshot.cn/v1
#   通义千问:  https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 可选：模型名，默认 gpt-4o-mini
OPENAI_MODEL=deepseek-v4-pro

# 可选：采样温度，默认 0.85（留空则不传该参数；o 系列推理模型需留空）
OPENAI_TEMPERATURE=0.85
